# Copy to .env (never commit .env). Values below are local-dev defaults.

MONGO_URI=mongodb://localhost:27017/supplychain
REDIS_URL=redis://localhost:6379/8
BLOB_ROOT=/opt/openMastiff/data/blobs
WORK_ROOT=/opt/openMastiff/data/work
SCANNER_MODE=local
API_HOST=0.0.0.0
API_PORT=18000
APP_CONFIG_FILE=/opt/openMastiff/config/app_config.json

# Optional LDAP (leave empty when using HTTP local accounts)
# LDAP_SERVER=ldap://ldap.example.com:389
# LDAP_BIND_USERNAME=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_ACCOUNT_BASE=ou=people,dc=example,dc=com
# LDAP_ACCOUNT_PATTERN=(&(objectClass=inetOrgPerson)(uid=${username}))
# LDAP_ACCOUNT_SSH_USERNAME=uid

# JWT_SECRET is generated on first-run setup if omitted
# JWT_SECRET=
# JWT_EXPIRE_HOURS=8
